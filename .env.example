# Set when a production domain is chosen. Empty means no canonical or sitemap.
NUXT_PUBLIC_SITE_URL=
# Enable ONLY for the production build after the domain is set.
SITE_INDEXABLE=false
# Must match the Cloudflare Pages production branch.
PRODUCTION_BRANCH=main
# Optional Search Console verification token, not the full meta tag.
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Set after a tested Web build is placed in public/game/ (e.g. /game/index.html).
NUXT_PUBLIC_GAME_URL=

