# Set when a production domain is chosen. Empty means no canonical or sitemap.
NUXT_PUBLIC_SITE_URL=
# Enable ONLY for the production build after the domain is set.
SITE_INDEXABLE=false
# Must match the Cloudflare Workers production branch.
PRODUCTION_BRANCH=main
# Optional Search Console verification token, not the full meta tag.
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Fixed same-origin Worker route, served from the private R2 bucket.
NUXT_PUBLIC_GAME_URL=/game/latest/index.html


# Local npm run publish:game credentials only. Never prefix with NUXT_PUBLIC_.
# Set once in the ignored .env; not needed by the website build.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=firefly-houston


# Optional Unity build configuration for npm run build:game.
# Empty project path defaults to ../../roguelike/GameJam2026 relative to this site.
UNITY_PROJECT_PATH=
# Empty Editor path uses the Unity Hub version from ProjectVersion.txt.
UNITY_EDITOR_PATH=
