{
  "name": "houston-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "node --test tests/*.test.mjs",
    "build": "nuxt generate && node scripts/finalize-build.mjs",
    "preview": "node scripts/preview.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy:preview": "wrangler pages deploy dist --branch preview",
    "build:local": "nuxt generate && node scripts/finalize-build.mjs --local"
  },
  "dependencies": {
    "nuxt": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.0.0",
    "@types/node": "^22.0.0"
  }
}
